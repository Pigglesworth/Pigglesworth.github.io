layout (location=0) out vec4 outColor;

uniform sampler2D texture0;
uniform vec4 color;

in vec2 uv;

void main()
{
	vec4 c = texture(texture0,uv);
	if(c.a < 0.1)
		discard;
	outColor = c * color;
}#version 330
layout (location = 0) in vec2 vertexPos;

out vec2 uv;

uniform vec2 size;
uniform vec3 pos;

uniform vec2 uvOffset;
uniform vec2 uvSize;

void main()
{
	float depth = 1.0 - (pos.z / 256.0);
	gl_Position = vec4(pos.x+vertexPos.x*size.x,pos.y+vertexPos.y*size.y,depth,1.0);
	uv = uvOffset + uvSize*vertexPos.xy;
}{
