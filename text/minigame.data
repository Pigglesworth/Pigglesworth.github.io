require 'mythmenu.lua'

TerminalData = {}

local mainMenu = {}
local selectSplitter = {}

local mm = MessageElement:createMenu()
local nm = NewsElement:createMenu()
local lm = MythMenu:createMenu()

local contentMenu = BackgroundElement:create(nil, false, { 512 - 32, 384 - 32 - 50 })

---@class BackgroundElement
local tabButtons = {}
do
    local buttonText = {
        "Chatlogs",
        "News",
        "Literature"
    }
    local buttonCallbacks = {
        function() contentMenu:setChild(mm) end,
        function() contentMenu:setChild(nm) end,
        function() contentMenu:setChild(lm) end,
    }
    for i = 1, 3 do
        tabButtons[i] = BackgroundElement:create(
            ButtonElement:create(GetDefaultFont(), '{gray}' .. buttonText[i],
                function()
                    for i, v in ipairs(tabButtons) do
                        v.child:setText('{gray}' .. buttonText[i])
                    end

                    local b = tabButtons[i].child
                    ---@cast b ButtonElement
                    b:setText('{white}' .. buttonText[i])
                    buttonCallbacks[i]()
                end,
                'center', { 150 - 5, 50 }, 150
            ),
            true, { 150 - 20, 50 }
        )
    end
end
local tabSplitter = SplitterElement:create(tabButtons, false, 16, nil, nil)


local selectSplitter = SplitterElement:create({ tabSplitter, contentMenu }, true)

mainMenu = Menu:create({ 16 - 2, 16 - 2 }, GetDefaultMenu(), { selectSplitter }, false)




TerminalData.MainMenu = mainMenu
MPos = { 0, 0 }

function Render()
    GlobalBlinkTimer = GlobalBlinkTimer + DT
    for _, e in pairs(Events) do
        if e.type == "MousePositionEvent" then
            MPos = VCpy(e.pos)
        end
    end

    local eles = { MessageElement, NewsElement, MythMenu }
    for i = 1, 3 do
        if eles[i]:hasUnread() then
            tabButtons[i]:setBlinkColor(1, 1, 0)
        else
            tabButtons[i]:setBlinkColor(1, 1, 1)
        end
    end

    TerminalData.MainMenu:render(Events)
end
require 'menu.lua'

---@alias PatternList {match: string, func: fun(self: TerminalElement, line: string): (MenuElement | boolean)?}

---@class MenuElementEx: MenuElement
---@field ax number?

---@class TerminalElement: MenuElement
---@field font Font
---@field buttons BackgroundElement[]
---@field textboxes MenuElementEx[]
---@field width number
---@field textsize number
---@field align string
---@field pos Vec2
---@field intro string?
---@field patternList PatternList[]
TerminalElement = Inherit(MenuElement)
TerminalElement.patternList = {}

---Message element
---@param font Font
---@param width number
---@param text string?
---@param align string?
---@param size integer
---@return TerminalElement
function TerminalElement:create(font, width, text, align, size)
    local ret = {}
    setmetatable(ret, self)
    self.__index = self

    text = text or ""
    size = size or 1
    ret.font = font
    ret.width = width
    ret.align = align
    ret.textsize = size
    ret.pos = { 0, 0 }
    ret.depth = 0

    ret.textboxes = {}
    ret:setText(text)
    return ret
end

---Get size
---@return Vec2
function TerminalElement:getSize()
    local sx = { self.width, 0 }

    local last = self.textboxes[#self.textboxes]
    if not last then return { 0, 0 } end
    sx[2] = (last:getPosition()[2] - self.pos[2]) + last:getSize()[2]

    return sx
end

function TerminalElement:setPosition(pos)
    self.pos = pos

    local szx = self.width
    local oy = 0
    local lastax = 0
    for _, t in ipairs(self.textboxes) do
        local tsz = t:getSize()
        local ox = t.ax * (szx - tsz[1])
        local axd = math.abs(lastax - t.ax)
        lastax = t.ax
        oy = oy + 10 * axd
        t:setPosition(VAdd(pos, { ox, oy }))
        oy = oy + tsz[2] + 3
    end
end

function TerminalElement:setVisible(visible)
    self.visible = visible
    for _, t in ipairs(self.textboxes) do
        t:setVisible(visible)
    end
end

function TerminalElement:setStencil(stencil)
    for _, t in ipairs(self.textboxes) do
        t:setStencil(stencil)
    end
end

function TerminalElement:getPatterns()
    return self.patternList
end

---@param match string
---@param func fun(self: TerminalElement, line: string): (MenuElement | boolean)?
function TerminalElement:addPattern(match, func)
    self.patternList[#self.patternList + 1] = {
        match = match,
        func = func
    }
end

---@return { name: string, content: string }[]
function TerminalElement:getContentList()
    return {}
end

TerminalElement:addPattern('%[size=%d+%]%s*[^\n]*', function(self, line)
    local num = line:match('%[size=%d*%]'):gsub('[^%d]*', '')
    local size = tonumber(num)
    local text = line:gsub('%[size=%d+%]%s*\n?', '')
    return TextboxElement:create(self.font, self.width, text, 'center', size)
end)

---Set textbox text
---@param text string
function TerminalElement:setText(text)
    for _, t in ipairs(self.textboxes) do
        t:destroy()
    end
    self.textboxes = {}

    self.ax = 0.5

    local match = true

    local fptxt = function(txt)
        return txt:gsub('^%s*', ''):gsub('%s*$', '')
    end

    while match do
        match = false
        local first = 999999
        local bestpattern
        for _, pattern in pairs(self:getPatterns()) do
            local m = text:find(pattern.match)
            if m and m < first then
                bestpattern = pattern
                first = m
            end
        end
        if bestpattern then
            match = true

            if first - 1 > 0 then
                local pref = fptxt(text:sub(1, first - 1))
                table.append(self.textboxes,
                    TextboxElement:create(self.font, self.width, pref, 'left', self.textsize))
                self.textboxes[#self.textboxes].ax = self.ax
            end

            local m = text:match(bestpattern.match)
            local ele = bestpattern.func(self, m)
            if ele ~= true then
                ---@cast ele MenuElementEx
                ele.ax = self.ax
                table.append(self.textboxes, ele)
            end

            text = text:sub(first + #m + 1)
        end
    end

    table.append(self.textboxes, TextboxElement:create(self.font, self.width, fptxt(text), 'left', self.textsize))
    self.textboxes[#self.textboxes].ax = self.ax

    self:setPosition(self.pos)
    self:setVisible(self.visible)
end

function TerminalElement:createMenu()
    local message
    local sidebar = {}
    do
        local content = self:getContentList()
        ---@type BackgroundElement[]
        local buttons = {}
        self.buttons = buttons
        for i, v in ipairs(content) do
            buttons[i] = BackgroundElement:create(
                ButtonElement:create(GetDefaultFont(), '{gray}' .. v.name,
                    function()
                        SaveData[v.name] = true
                        self:updateBlink()
                        message:setText(v.content)
                        for j, v in ipairs(buttons) do
                            local c = buttons[j].child
                            ---@cast c ButtonElement
                            if i == j then
                                c:setText(c.text:gsub('gray', 'white'))
                            else
                                c:setText(c.text:gsub('white', 'gray'))
                            end
                        end
                    end,
                    'center', { 150 - 20, 50 }, 150 - 25
                ),
                true, { 150 - 20, 50 })
        end
        self:updateBlink()
        sidebar = ScrollElement:create(
            SplitterElement:create(buttons, true, 1),
            true, { 150, 284 }, nil, 0.0
        )
    end

    message = self:create(GetDefaultFont(), 512 - 32 - sidebar:getSize()[1] - 20, '', 'center', 1)
    if message.intro then
        message.textboxes = {}

        local tx = TextboxElement:create(message.font, message.width - 40, message.intro, 'left', message.textsize)
        local ime = ImageElement:create('../shared/icon.png', { 0, 0, 34, 34 }, nil, 4, 0.03)
        table.append(message.textboxes,
            SplitterElement:create({ ime, tx }, false))
        local se = message.textboxes[1]
        se.ax = 0
        se:setDepth(150)
    end
    return SplitterElement:create({
        sidebar,
        ScrollElement:create(message, true, { 512 - 32 - sidebar:getSize()[1], 284 }),
    }, false, 0, 'left', { 512 - 32, 384 - 20 - 50 })
end

function TerminalElement:updateBlink()
    local content = self:getContentList()
    for i, v in ipairs(content) do
        if not SaveData[v.name] then
            self.buttons[i]:setBlinkColor(1, 1, 0)
        else
            self.buttons[i]:setBlinkColor(1, 1, 1)
        end
    end
end

function TerminalElement:hasUnread()
    local content = self:getContentList()
    local hasUnread = false
    for i, v in ipairs(content) do
        if not SaveData[v.name] then
            self.buttons[i]:setBlinkColor(1, 1, 0)
            hasUnread = true
        else
            self.buttons[i]:setBlinkColor(1, 1, 1)
        end
    end
    return hasUnread
end
