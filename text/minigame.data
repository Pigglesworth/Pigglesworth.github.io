␀␀␀IHDR␀␀␀	␀␀␀	␀␀␀×Oö"␀␀␀sRGB␀®Îé␀␀␀gAMA␀␀±üa␀␀␀PLTEÿÿÿ␀␀␀UÂÓ~␀␀␀tRNSÿ␀å·0J␀␀␀	pHYs␀␀Â␀␀Â(J€␀␀␀tEXtSoftware␀Paint.NET 5.1.8iê¨␀␀␀¶eXIfII*␀␀␀␀␀␀␀␀␀J␀␀␀␀␀␀␀R␀␀␀(␀␀␀␀␀␀␀1␀␀␀␀Z␀␀␀i‡␀␀␀␀j␀␀␀␀␀␀␀òv␀è␀␀òv␀è␀␀Paint.NET 5.1.8␀␀␀␀␀␀␀0230 ␀␀␀␀␀␀␀ ␀␀␀␀”␀␀␀␀␀␀␀␀␀␀␀␀␀R98␀␀␀␀␀␀0100␀␀␀␀Ìn|JSè␀␀␀IDATWc`d€␀M)€šÃÀ␀␀‡Ïÿ␀␀␀␀IEND®B`‚require 'sprite.lua'
require 'utils.lua'

---@type fun(path: string): any
load = load

local UITextDepth = 101

---@class CharacterData
---@field spriteData SpriteData
---@field offset Vec2
---@field advance integer
---@field width integer

---@class Font
---@field width integer
---@field height integer
---@field characters { [string] : CharacterData }
Font = {}
Font.__index = Font

---Create Font
---@param imgpath string
---@param luapath string
---@return Font
function Font:create(imgpath, luapath)
    ---@type table
    local fontDesc = load(luapath)

    ---@type CharacterData[]
    local chars = {}

    local width = 0
    local height = fontDesc.common.lineHeight
    for _, v in pairs(fontDesc.chars) do
        local size = { v.width, v.height }
        local rect = { v.x, v.y, v.width, v.height }
        chars[v.letter] = {
            spriteData = SpriteData:create(imgpath, size, rect, UITextDepth),
            offset = { v.xoffset, v.yoffset },
            advance = v.xadvance,
            width = v.width
        }
        width = math.max(width, v.xadvance)
    end

    ---@type Font
    local font = {
        width = width,
        height = height,
        characters = chars,
    }

    setmetatable(font, self)
    return font
end

local textColors = {
    white = { 1, 1, 1 },
    red = { 1, 0, 0 },
    green = { 0, 1, 0 },
    blue = { 0, 0, 1 },
    yellow = { 1, 1, 0 },
    cyan = { 0, 1, 1 },
    magenta = { 1, 0, 1 },
    gray = { 0.5, 0.5, 0.5 }
}

local textAligns = {
    left = 'left',
    middle = 'middle',
    right = 'right'
}

---Create Textbox from Font
---@param text string
---@param size Vec2?
---@param pos Vec2?
---@param align string?
---@param scale number?
---@return Textbox
function Font:makeText(text, size, pos, align, scale)
    ---@type Sprite[]
    local sprites = {}

    scale = scale or 1
    local color = { 1, 1, 1 }
    local wordList = {}
    local mlcallback
    for word in text:gmatch('[%s]*[%S]+[%s%s]*[\n]*') do
        local callback = mlcallback
        for mods in word:gmatch('{[%w=%.!]*}') do
            if mods:sub(2, 7) == 'scale=' then
                scale = tonumber(mods:sub(8, #mods - 1)) or 1
            elseif mods:sub(2, 10) == 'callback=' then
                callback = mods:sub(11, #mods - 1)
            elseif mods:sub(2, 12) == 'mlcallback=' then
                mlcallback = mods:sub(13, #mods - 1)
                callback = mlcallback
            elseif mods:sub(2, 3) == '!c' then
                mlcallback = nil
            else
                local m = (mods:sub(2, #mods - 1))
                if textColors[m] then color = textColors[m] end
                if textAligns[m] then align = textAligns[m] end
            end
        end
        word = word:gsub('%b{}', '')

        local wordVal = {}
        wordList[#wordList + 1] = wordVal

        local x = 0
        for i = 1, #word do
            local c = string.sub(word, i, i)
            local cs = self.characters[c]
            if cs then
                wordVal[#wordVal + 1] = { char = cs, c = c }
                x = x + cs.advance * scale
                if i == #word then x = x - cs.advance * scale + cs.width * scale end
            elseif c == '\n' or c == '\t' then
                wordVal[#wordVal + 1] = { c = c }
            end
        end
        wordVal.width = x
        wordVal.color = color
        wordVal.scale = scale
        wordVal.callback = callback
    end

    if not size then size = { 999999, 999999 } end

    local px = pos and pos[1] or 0
    local py = pos and pos[2] or 0
    local x = 1
    local y = 0
    local maxx = 0
    local maxy = 0
    local lineLengths = { { x = 0, sprites = {} } }

    local advanceLine = function(sc)
        sc = sc or scale
        lineLengths[#lineLengths].x = x
        lineLengths[#lineLengths + 1] = { x = 0, sprites = {} }
        maxx = math.max(maxx, x)
        x = 1
        y = y + self.height * sc
    end

    ---@type {rect: Rect, name: string}[]
    local callbacks = {}
    for _, w in ipairs(wordList) do
        local oldScale = scale
        scale = w.scale
        if x > 1 and x + w.width > size[1] then advanceLine(oldScale) end
        if x > 0 then x = x + self.characters[" "].advance * scale end
        local xst, yst = x, y
        local col = w.callback and { 0, 0.5, 1 } or w.color
        for _, wc in ipairs(w) do
            local cs = wc.char
            if cs then
                sprites[#sprites + 1] = cs.spriteData:createSprite(
                    { x + px + cs.offset[1] * scale, y + py + cs.offset[2] * scale }, VMul(cs.spriteData.size, scale))
                local s = sprites[#sprites]
                s.camera = false
                s.r = col[1]
                s.g = col[2]
                s.b = col[3]
                table.append(lineLengths[#lineLengths].sprites, sprites[#sprites])
                x = x + cs.advance * scale
            end
            if wc.c == '\n' then advanceLine() end
        end
        if w.callback then
            local lastCallback = #callbacks > 0 and
                callbacks[#callbacks] or
                { rect = { -99, -99, 0, 0 }, name = '' }
            local st = { xst, yst }
            if RContains(VAdd(st, { -10, 0 }), lastCallback.rect) and lastCallback.name == w.callback then
                local xend = x + 2 * scale
                lastCallback.rect[3] = xend - lastCallback.rect[1]
            else
                table.insert(callbacks,
                    {
                        rect = Rect(st, { x - xst + 2 * scale, self.height * scale }),
                        name = w.callback
                    })
            end
        end
    end
    maxy = y + self.height * scale
    advanceLine()
    maxx = maxx + (scale + 1) * 2

    if align then
        local mul = 0
        if align == 'center' then mul = 0.5 end
        if align == 'right' then mul = 1.0 end
        for _, v in ipairs(lineLengths) do
            for _, s in ipairs(v.sprites) do
                s.x = s.x + math.floor((maxx - v.x) * mul)
            end
        end
    end

    if #sprites > 1 then
        sprites = { StitchSprite(sprites) }
    end

    ---@type Textbox
    local textbox = Textbox:create({ px, py }, { maxx, maxy }, sprites, callbacks)
    return textbox
end

---Create a single character sprite from the font
---@param character string
---@return CharacterData
function Font:getCharacterData(character)
    local cs = self.characters[character] or self.characters[" "]
    return cs
end

---@class Textbox
---@field pos Vec2
---@field size Vec2 the size of the rect enclosing the text
---@field sprites Sprite[]
---@field callbacks {rect: Rect, name: string}[]
Textbox = {}
Textbox.__index = Textbox

---Create a textbox, where the sprites are individual letters
---@param pos Vec2
---@param size Vec2
---@param sprites Sprite[]
---@param callbacks {rect: Rect, name: string}[]
function Textbox:create(pos, size, sprites, callbacks)
    local ret = {
        pos = VCpy(pos),
        size = size,
        sprites = sprites,
        callbacks = callbacks
    }
    setmetatable(ret, self)
    return ret
end

---Set the position of the textbox
---@param pos Vec2
function Textbox:setPosition(pos)
    local dx = pos[1] - self.pos[1]
    local dy = pos[2] - self.pos[2]
    self.pos = VCpy(pos)
    for _, v in pairs(self.sprites) do
        v.x = v.x + dx
        v.y = v.y + dy
    end
end

---Set the depth of the textbox
---@param depth number
function Textbox:setDepth(depth)
    for _, v in pairs(self.sprites) do
        v.depth = depth
    end
end

---Set the visibility of the textbox
---@param visible boolean
function Textbox:setVisible(visible)
    for _, v in pairs(self.sprites) do
        v.visible = visible
    end
end

---Return the size of the text
---@return Vec2
function Textbox:getSize()
    return self.size
end

function Textbox:setColor(r, g, b, a)
    a = a or 1
    for _, v in pairs(self.sprites) do
        v.r = r
        v.g = g
        v.b = b
        v.a = a
    end
    return self
end

---Destroy the textbox sprites
function Textbox:destroy()
    for k, v in pairs(self.sprites) do
        self.sprites[k].visible = false
        self.sprites[k] = nil
    end
end

---Set the stencil value
---@param stencil integer
function Textbox:setStencil(stencil)
    for _, v in pairs(self.sprites) do
        v.stencil = stencil
    end
end

---Do callbacks for text events
---@param events EventList
---@param callback fun(name: string, rect: Rect)
function Textbox:doCallbacks(events, callback)
    DoEvent('MouseButtonEvent', events, function(e)
        if e.action ~= 1 then return end
        for _, v in ipairs(self.callbacks) do
            if RContains(e.pos, RAdd(v.rect, self.pos)) then
                callback(v.name.sub(1, 1) == '!' and v.name:sub(2) or v.name, RAdd(v.rect, self.pos))
            end
        end
    end)
    for _, v in ipairs(self.callbacks) do
        if v.name:sub(1, 1) == '!' and RContains(MPos, RAdd(v.rect, self.pos)) then
            callback(v.name, RAdd(v.rect, self.pos))
        end
    end
end

function GetDefaultFont()
    if not DefFont then
        DefFont = Font:create(
            '../shared/sprites/BasicPupWhite.png',
            '../shared/sprites/BasicPupWhite.lua')
    end
    return DefFont
end
