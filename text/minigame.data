#version 330
layout (location=0) out vec4 outColor;

uniform sampler2D texture0;
uniform vec4 color;
uniform int width;

in vec2 uv;

void main()
{
	float c = 0.0;
	float samples = width * 2.0 + 1.0;
	vec2 tx = 1.0 / vec2(1280.0,720.0);
	for(float i = 0; i < samples; i++)
	{
		vec2 offset = vec2(i - width,0.0);
		c = max(c,texture(texture0,uv + offset * tx).r);
	}
	//c /= div;
	outColor = vec4(1.0,1.0,0.0,smoothstep(0.15,0.2,c));
}#version 330
layout (location=0) out vec4 outColor;

uniform sampler2D texture0;
uniform vec4 color;
uniform int width;

in vec2 uv;

void main()
{
	float c = 0.0;
	float samples = width * 2.0 + 1.0;
	vec2 tx = 1.0 / vec2(1280.0,720.0);
	for(int j = 0; j < 3; j++)
	{
		for(float i = 0; i < samples; i++)
		{
			vec2 offset = vec2(0.5*j - 0.5,i - width);
			c = max(c,texture(texture0,uv + offset * tx).r);
		}
	}
	//c /= samples;
	outColor = vec4(c,c,0.0,1.0);
}#version 300 es
layout (location=0) out vec4 outColor;

uniform sampler2D texture0;
uniform vec4 color;

in vec2 uv;

void main()
{
	vec4 c = texture(texture0,uv);
	outColor = c * color;
}#version 300 es
layout (location = 0) in vec4 vertexPos;

out vec2 uv;

void main()
{
	gl_Position = vertexPos;
	uv = vertexPos.xy * 0.5 + 0.5;
}#version 330
layout (location=0) out vec4 outColor;

uniform vec4 color;

void main()
{
	outColor = color;
}#version 330
layout (location = 0) in vec4 vertexPos;
uniform mat4 proj;
uniform mat4 model;

void main()
{
	gl_Position = proj * model * vertexPos;
}#version 330
layout (location=0) out vec4 outColor;

void main()
{
	outColor = vec4(1.0,1.0,1.0,1.0);
}#version 330
layout (location=0) out vec4 outColor;

uniform vec4 color;

void main()
{
	outColor = color;
}#version 330
layout (location = 0) in vec4 vertexPos;
uniform mat4 proj;
uniform mat4 model;

void main()
{
	gl_Position = proj * model * vertexPos;
}#version 330
layout (location = 0) in vec2 vertexPos;
uniform mat3 proj;
uniform mat3 model;

out vec2 uv;

void main()
{
	gl_Position = vec4((proj * model * vec3(vertexPos,1.f)).xy,0.f,1.f);
	uv = vertexPos*vec2(-1.0,1.0)+vec2(0.5,0.5);
}#version 330
layout (location=0) out vec4 outColor;

uniform vec4 color;
uniform sampler2D texture0;
in vec2 uv;

void main()
{
	outColor = texture(texture0,uv)*color;
}#version 330
layout (location = 0) in vec4 vertexPos;
layout (location = 1) in vec2 vertexUV;
uniform mat4 proj;
uniform mat4 model;

out vec2 uv;

void main()
{
	gl_Position = proj * model * vertexPos;
	uv = vertexUV;
}#version 330
layout (location=0) out vec4 outColor;

in vec3 pos;

uniform float time;

uniform vec4 c1;
uniform vec4 c2;

const float CELL_SIZE = 0.04;

float rand(vec3 co){
    return fract(sin(dot(co, vec3(12.9898, 78.233, 824.184))) * 43758.5453);
}

vec3 cAt(vec3 fp, float cSize)
{
	vec3 c = (fp+mod(rand(fp)*0.7+0.5,1.0)) * cSize;
	float cX = rand(fp);
	c += vec3(sin(time*cX*5.8)*0.3,sin(time*cX*4.5)*0.3,cos(time*cX*3.4)*0.3) * cSize;
	return c;
}

void main()
{
	float cp = 1.0;
	for(int x = -1; x <= 1; x++)
	{
		for(int y = -1; y <= 1; y++)
		{
			for(int z = -1; z <= 1; z++)
			{
				vec3 fp = floor(pos / CELL_SIZE) + vec3(float(x),float(y),float(z));
				//cp = min(cp,distance(pos,cAt(fp,CELL_SIZE)) / (CELL_SIZE*1.4));
				vec3 dif = (pos - cAt(fp,CELL_SIZE)) / (CELL_SIZE*1.4);
				dif = abs(dif) * 0.8;
				cp = min(cp,dif.x+dif.y+dif.z);
			}
		}
	}
	cp = pow(1.0-cp,0.6);
	outColor = mix(c1,c2,cp);
}#version 330
layout (location = 0) in vec4 vertexPos;
uniform mat4 proj;
uniform mat4 model;

out vec3 pos;

void main()
{
	gl_Position = proj * model * vertexPos;
	pos = (model * vertexPos).xyz;
}#version 330
layout (location=0) out vec4 outColor;

uniform sampler2D texture0;
uniform float time;
in vec2 uv;

float rand(float co){
    return (sin(co*26.0) + sin(co*13.0) + fract((sin(co * 12413.9898)) * 48.545)) * 0.5;
}

float columnTimeOffset(float x)
{
	const float columnCount = 120.0;
	float column = (floor(x*columnCount)/columnCount);
	column = rand(column) * 0.5;
	
	return max(time*1.5 - column*0.3 - 0.2,0.0);
}

void main()
{
	vec2 uvOffset = uv;
	uvOffset.y += columnTimeOffset(uv.x);

	float a = uvOffset.y > 1.0 ? 0.0 : 1.0;

	outColor = vec4(texture(texture0,uvOffset).rgb,a);
}#version 330
layout (location = 0) in vec2 vertexPos;

out vec2 uv;

void main()
{
	gl_Position = vec4(vertexPos,1.0,1.0);
	uv = vertexPos*vec2(0.5,0.5)+vec2(0.5,0.5);
}#version 330
layout (location=0) out vec4 outColor;

in vec4 color;
in vec3 pos;
in vec3 nrm;

uniform float time;

float pivotSmooth(float x, float dw)
{
	const float width = 0.05;
	float dx = abs((mod(x+0.5+width*0.5,1.0) * (1.0+width)) - width*0.5);
	return smoothstep(width*(dw*0.4),width*(dw*0.5),dx);
}

void main()
{
	float dx = clamp(gl_FragCoord.z*2.4-1.0,0.5,1.0);
	float x1 = pivotSmooth(pos.x, dx);
	float y1 = pivotSmooth(pos.y, dx);
	float z1 = pivotSmooth(pos.z+0.5, dx);
	float xy = x1*z1*nrm.y*nrm.y + y1*z1*nrm.x*nrm.x + nrm.z*nrm.z;
	outColor = vec4((xy * color).xyz,1.0);
}#version 330
layout (location = 0) in vec4 vertexPos;
layout (location = 1) in vec4 vertexNrm;
layout (location = 2) in vec4 vertexCol;
uniform mat4 proj;
uniform mat4 model;

out vec4 color;
out vec3 pos;
out vec3 nrm;

void main()
{
	vec4 p =  proj * model * vertexPos;
	gl_Position = proj * model * vertexPos;
	color = vertexCol;
	pos = (model * vertexPos).xyz;
	nrm = vertexNrm.xyz;
}#version 430
layout (location=0) out vec4 color;
in vec2 vp;
uniform float height;
uniform float fade;
void main()
{
	color = vec4(vp.x,vp.y*height,1.0,1.0) * vec4(fade,fade,fade,1.0);
}#version 430
layout (location = 0) in vec2 vertexPos;
out vec2 vp;
uniform float offY;
uniform float height;
uniform mat4 MVP;
void main()
{
	vec3 p = vec3(vertexPos,offY);
	p.x = p.x * 2.0 - 1.0;
	vp = vec2(vertexPos.x,p.y * height);
	p.y = (p.y - 0.5) * height;
	p.y *= 0.1;
	gl_Position = MVP * vec4(p,1.0);
}#version 300 es
precision mediump float;
in vec2 tex;
in vec4 col;
uniform sampler2D inputTexture;
layout (location=0) out vec4 outColor;
void main()
{
	outColor = texture(inputTexture,tex) * col;
}#version 300 es
precision mediump float;
layout (location = 0) in vec2 vertexPos;
layout (location = 1) in vec2 vertexTex;
layout (location = 2) in vec4 vertexCol;
out vec2 tex;
out vec4 col;
uniform mat4 mvp;
void main()
{
	gl_Position = mvp * vec4(vertexPos.xy,1.0,1.0);
	tex = vertexTex;
	col = vertexCol;
}#version 430
layout (location=0) out vec4 outColor;

uniform sampler2D t0;
uniform vec4 color;
uniform float sharpness;
in vec2 tex;

void main() {
   float d = texture(t0,tex).a;
   vec4 c = vec4(1.0,1.0,1.0,1.0);
   float dis = 0.25 * clamp(sharpness,0.0,2.0);
   float a = smoothstep(0.5 - dis, 0.5 + dis, d);
   outColor = color*vec4(c.rgb,a);
}#version 430
layout(location = 0) in vec2 pos;
layout(location = 1) in vec2 tex0;
out vec2 tex;
uniform vec2 offset;
uniform vec2 scale;
void main() {
   gl_Position = vec4(scale*pos+offset,1.0,1.0);
   tex = tex0;
}#version 430
layout (location=0) out vec4 outColor;

uniform sampler2D t0;
uniform vec4 color;
uniform vec4 outline;

in vec2 tex;

void main() {
   float sharpness = abs(dFdx(tex.x)) * 256.0;
   float d = texture(t0,tex).a;
   vec4 c = vec4(1.0,1.0,1.0,1.0);
   float dis = 0.25 * clamp(sharpness,0.0,2.0);
   float a = smoothstep(0.3 - dis, 0.3 + dis, d);
   
   float m = smoothstep(0.3, 0.75, d);
   c = mix(outline,color,m);
   
   outColor = vec4(c.rgb,a);
}#version 430
layout (location=0) out vec4 outColor;

uniform sampler2D t0;
uniform vec4 color;

in vec2 tex;

void main() {
   float sharpness = abs(dFdx(tex.x)) * 256.0;
   float d = texture(t0,tex).a;
   vec4 c = vec4(1.0,1.0,1.0,1.0);
   float dis = 0.25 * clamp(sharpness,0.0,2.0);
   float a = smoothstep(0.5 - dis, 0.5 + dis, d);
   outColor = color*vec4(c.rgb,a);
}#version 430
layout(location = 0) in vec2 pos;
layout(location = 1) in vec2 tex0;

uniform mat4 proj;
uniform mat4 model;

out vec2 tex;

void main() {
   vec4 p = model * vec4(pos.x,0.0,-pos.y,1.0);
   p = proj * p;
   gl_Position = p;
   tex = tex0;
