	target = "intro0"
	triggers = [
		{type = "WindowShown", id = 1, time = 2.5},
		{type = "RoomNumber", name = "opening"},
	]
[[transitions]]
	target = "intro6"
	triggers = [
		{type = "ObjectVisible", name = "DoorObject"},
		{type = "RoomNumber", name = "opening"},
	]
	
	
[[lines]]
	name = "intro0"
	path = "waifu/tutorial/intro0.ogg"
	effects = [
		{time = 999.0, effect = {type = "ShowWindows"}}
	]
[[lines.transitions]]
	target = "intro1"
	triggers = [
		{type = "WindowShown", time = 2.0}
	]


[[lines]]
	name = "intro1"
	path = "waifu/tutorial/intro1.ogg"
	effects = [{time = 999.0, effect = {type = "Keybind", key = "Pause"}}]
[[lines.transitions]]
	target = "intro2"
	triggers = [
		{type = "DialogueFinished"},
		{type = "KeyBound", key = "Pause"},
	]
[[lines.transitions]]
	target = "intro5_skip"
	triggers = [
		{type = "TimelineBetween", start = 0, end = 200},
	]


[[lines]]
	name = "intro2"
	path = "waifu/tutorial/intro2.ogg"
[[lines.transitions]]
	target = "intro3"
	triggers = [
		{type = "PlayerMoved", distance = 5.0, rotated = 360.0},
		{type = "TimePassed", time = 3.0},
	]
[[lines.transitions]]
	target = "intro5_skip"
	triggers = [
		{type = "TimelineBetween", start = 0, end = 200},
	]


[[lines]]
	name = "intro3"
	path = "waifu/tutorial/intro3.ogg"
[[lines.transitions]]
	target = "intro4"
	triggers = [
		{type = "DialogueFinished"},
		{type = "GamePaused"},
	]
[[lines.transitions]]
	target = "intro3_pause"
	triggers = [
		{type = "DialogueFinished"},
		{type = "GamePaused", paused = 0},
	]
	
	
[[lines]]
	name = "intro3_pause"
	path = "waifu/tutorial/intro3_pause.ogg"
[[lines.transitions]]
	target = "intro4"
	triggers = [
		{type = "DialogueFinished"},
		{type = "GamePaused"},
	]
	
	
[[lines]]
	name = "intro4"
	path = "waifu/tutorial/intro4.ogg"
[[lines.transitions]]
	target = "intro5"
	triggers = [
		{type = "TimelineBetween", start = 0, end = 200},
	]
	
	
[[lines]]
	name = "intro5"
	path = "waifu/tutorial/intro5.ogg"
[[lines.transitions]]
	target = "intro5_r1"
	triggers = [
		{type = "SwapTriggered"},
	]
[[lines]]
	name = "intro5_r1"
	path = "waifu/tutorial/intro5_r1.ogg"
	effects = [
		{time = 0.0, effect = {type = "SetEmotion", emotion = "Sorrow", weight = 0.7}}
		{time = 999.0, effect = {type = "SetEmotion", emotion = "Neutral", weight = 1.0}}
	]
[[lines.transitions]]
	target = "intro5_r2"
	triggers = [
		{type = "SwapTriggered"},
	]
[[lines]]
	name = "intro5_r2"
