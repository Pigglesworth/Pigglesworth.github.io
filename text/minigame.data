require 'text.lua'

local UIDepth = 100


---@class RectSpriteData
---@field segments SpriteData[]
---@field segmentSize Vec2
RectSpriteData = {}
RectSpriteData.__index = RectSpriteData

---Define a rect sprite, a sprite that nicely stretches for things like menus
---@param path string
---@return RectSpriteData
function RectSpriteData:create(path)
    local size = { 3, 3 }
    ---@type RectSpriteData
    local rectData = {
        segments = {},
        segmentSize = size
    }
    setmetatable(rectData, self)

    for i = 1, 9 do
        local x = (i - 1) % 3
        local y = math.floor((i - 1) / 3)
        local tx = size[1] * x
        local ty = size[2] * y
        rectData.segments[i] = SpriteData:create(path, size, { tx, ty, size[1], size[2] }, UIDepth)
    end

    return rectData
end

---Create Sprite
---@param pos Vec2
---@return RectSprite
function RectSpriteData:createSprite(pos, size)
    ---@type RectSprite
    local rectSprite = {
        pos = { pos[1], pos[2] },
        size = { size[1], size[2] },
        sprites = {}
    }

    local xMidSize = size[1] - 2 * self.segmentSize[1]
    local yMidSize = size[2] - 2 * self.segmentSize[2]

    local py = 0
    for y = 1, 3 do
        local ysize = y == 2 and yMidSize or self.segmentSize[1]
        local px = 0
        for x = 1, 3 do
            local xsize = x == 2 and xMidSize or self.segmentSize[2]
            local i = x + (y - 1) * 3
            local segment = self.segments[i]
            rectSprite.sprites[i] = segment:createSprite({ px, py }, { xsize, ysize })
            px = px + xsize
        end
        py = py + ysize
    end

    local inner = table.remove(rectSprite.sprites, 5)
    rectSprite.sprites = { StitchSprite(rectSprite.sprites), inner }

    setmetatable(rectSprite, RectSprite)
    return rectSprite
end

---@class RectSprite
---@field pos Vec2
---@field size Vec2
---@field sprites Sprite[]
---@field color number[]?
RectSprite = {}
RectSprite.__index = RectSprite

---Set position
---@param pos Vec2
function RectSprite:setPosition(pos)
    pos[1] = math.floor(pos[1] + 0.5)
    pos[2] = math.floor(pos[2] + 0.5)
    local dx = pos[1] - self.pos[1]
    local dy = pos[2] - self.pos[2]
    self.pos = VCpy(pos)
    for _, v in pairs(self.sprites) do
        v.x = v.x + dx
        v.y = v.y + dy
    end
end

---Set depth
---@param depth number
function RectSprite:setDepth(depth)
    for _, v in pairs(self.sprites) do
        v.depth = depth
    end
end

---Set visibility
---@param visible boolean
function RectSprite:setVisible(visible)
    for _, v in pairs(self.sprites) do
        v.visible = visible
    end
end

---Set stencil
---@param stencil integer
function RectSprite:setStencil(stencil)
    for _, v in pairs(self.sprites) do
        v.stencil = stencil
    end
end

---Set color
---@param r number
---@param g number
---@param b number
function RectSprite:setColor(r, g, b)
    self.color = { r, g, b }
    for _, v in pairs(self.sprites) do
        v.r = r
        v.g = g
        v.b = b
    end
end

function GetDefaultMenu()
    if not DefMenuSprite then DefMenuSprite = RectSpriteData:create('../shared/sprites/border.png') end
    return DefMenuSprite
end

function GetDefaultScroll()
    if not DefScrollSprite then DefScrollSprite = RectSpriteData:create('../shared/sprites/bwhite.png') end
    return DefScrollSprite
end

---@class MenuElement
---@field visible boolean
---@field size Vec2
MenuElement = {}
MenuElement.__index = MenuElement

---Create a new abstract menu element
---@return MenuElement
function MenuElement:create()
    local ret = {}
    setmetatable(ret, self)
    self.__index = self
    self.visible = false
    self.size = { 0, 0 }
    return ret
end

---Set the size of a menu element
---@param size Vec2
function MenuElement:setSize(size)
    self.size = size
end

---Get the size of a menu element
---@return Vec2
function MenuElement:getSize()
    return { 0, 0 }
end

---Set the position of a menu element
---@param pos Vec2
function MenuElement:setPosition(pos)
    for _, v in pairs(self) do
        if type(v) == "table" and v.setPosition then v:setPosition(pos) end
    end
    self.pos = VCpy(pos)
end

---Get the position of a menu element
---@return Vec2
function MenuElement:getPosition()
    return self.pos or { -999, -999 }
end

---Set the depth of a menu element
---@param depth number
function MenuElement:setDepth(depth)
    self.depth = depth
    depth = depth + 0.1
    for _, v in pairs(self) do
        if type(v) == "table" and v.setDepth then v:setDepth(depth) end
    end
end

---Get the depth of a menu element
---@return number
function MenuElement:getDepth()
    return self.depth
end

---Set the visibility of a menu element
---@param visible boolean
function MenuElement:setVisible(visible)
    for _, v in pairs(self) do
        if type(v) == "table" and v.setVisible then v:setVisible(visible) end
    end
    self.visible = visible
end

---Handle rendering and events
---@param events EventList
function MenuElement:render(events)
    for _, v in pairs(self) do
        if type(v) == "table" and v.render then v:render(events) end
    end
end

---Destroy all data
function MenuElement:destroy()
    for _, v in pairs(self) do
        if type(v) == "table" and v.destroy then v:destroy() end
    end
end

---Set the stencil value
---@param stencil integer
function MenuElement:setStencil(stencil)
    for _, v in pairs(self) do
        if type(v) == "table" and v.setStencil then
            v:setStencil(stencil)
        end
    end
end

---@class TextboxElement: MenuElement
---@field font Font
---@field textbox Textbox
---@field width number
---@field align string?
---@field pos Vec2
TextboxElement = MenuElement:create()
TextboxElement.__index = TextboxElement

---Textbox element
---@param font Font
---@param width number
---@param text string?
---@param align string?
---@return TextboxElement
function TextboxElement:create(font, width, text, align, size)
    local ret = {}
    setmetatable(ret, self)
    self.__index = self

    text = text or ""
    size = size or 1
    ret.font = font
    ret.width = width
    ret.align = align
    ret.textbox = font:makeText(text, { width, 9999 }, nil, align, size)
    ret.pos = { 0, 0 }

    return ret
end

---Set position
---@param pos Vec2
function TextboxElement:setPosition(pos)
    self.pos = pos
    self.textbox:setPosition(VAdd(pos, { 1, 1 }))
end

---Get position
---@return Vec2
function TextboxElement:getPosition()
    return self.pos
end

---Get size
---@return Vec2
function TextboxElement:getSize()
    return VAdd(self.textbox:getSize(), { 2, 2 })
end

---Set textbox text
---@param text string
function TextboxElement:setText(text)
    self.textbox:destroy()
    self.textbox = self.font:makeText(text, { self.width, 9999 }, nil, self.align)
    if self.visible == false then self.textbox:setVisible(false) end
end

---Set stencil
---@param stencil integer
function TextboxElement:setStencil(stencil)
    self.textbox:setStencil(stencil)
end

---comment
---@param events EventList
---@param callback fun(name: string, rect: Rect)
function TextboxElement:doCallbacks(events, callback)
    self.textbox:doCallbacks(events, callback)
end

---@class BackgroundElement: MenuElement
---@field child MenuElement
---@field background RectSpriteData?
---@field backSprite RectSprite?
---@field blinkColor number[]?
---@field blinkTime number
---@field size Vec2
---@field align string
BackgroundElement = MenuElement:create()
BackgroundElement.__index = BackgroundElement

---Create a background
---@param child MenuElement?
---@param background boolean|RectSpriteData?
---@param size Vec2?
---@param align string?
---@return BackgroundElement
function BackgroundElement:create(child, background, size, align)
    child = child or MenuElement:create()
    ---@cast background RectSpriteData?
    local bg = background
    if bg == nil or bg == true then
        bg = GetDefaultMenu()
    elseif bg == false then
        bg = nil
    end
    size = size or { 0, 0 }
    align = align or 'center'
    local chSize = child:getSize()
    local bgSize = { math.max(chSize[1], size[1]), math.max(chSize[2], size[2]) }
    ---@type BackgroundElement
    local bg = {
        child = child,
        background = bg,
        backSprite = bg and bg:createSprite({ 0, 0 }, bgSize),
        size = size,
        align = align,
        blinkTime = 0
    }
    setmetatable(bg, self)
    self.__index = self

    bg:setVisible(false)

    return bg
end

---@param pos Vec2
function BackgroundElement:setPosition(pos)
    self.pos = VCpy(pos)
    local childSize = self.child:getSize()
    local size = self:getSize()
    local mul = { 0.5, 0.5 }
    if self.align == 'left' then mul[1] = 0.0 end
    if self.align == 'right' then mul[1] = 1.0 end
    if self.align == 'bottom' then mul[2] = 1.0 end
    if self.align == 'top' then mul[2] = 0.0 end
    if self.align == 'topright' then mul = { 1.0, 0.0 } end
    self.child:setPosition(VAdd(self.pos, VMul(VSub(size, childSize), mul)))
    if self.backSprite then self.backSprite:setPosition(pos) end
end

---Set the depth of a menu element
---@param depth number
function BackgroundElement:setDepth(depth)
    self.depth = depth
    depth = depth + 0.1
    for _, v in pairs(self) do
        if type(v) == "table" and v.setDepth then v:setDepth(depth) end
    end
    if self.backSprite then self.backSprite:setDepth(self.depth) end
end

---@param size Vec2
function BackgroundElement:setSize(size)
    if VEq(self.size, size) then return end
    self.backSprite = GetDefaultMenu():createSprite({ 0, 0 }, size)
    self.backSprite:setVisible(self.visible)
    self.size = size
    self:setPosition(self.pos)
end

---@return Vec2
function BackgroundElement:getSize()
    local sz = self.child:getSize()
    return { math.max(sz[1], self.size[1]), math.max(sz[2], self.size[2]) }
end

---@param child MenuElement?
function BackgroundElement:setChild(child)
    if self.child then
        self.child:setVisible(false)
    end
    self.child = child or MenuElement:create()
    self:setPosition(self.pos)
    self:setVisible(true)
    self:setDepth(self.depth)
end

---Set the stencil value
---@param stencil integer
function BackgroundElement:setStencil(stencil)
    self.child:setStencil(stencil)
    if self.backSprite then self.backSprite:setStencil(stencil) end
end

---Set the stencil value
---@param r number
---@param g number
---@param b number
function BackgroundElement:setBlinkColor(r, g, b)
    self.blinkColor = { r, g, b }
end

GlobalBlinkTimer = 0
---Render blinks
---@param events EventList
function BackgroundElement:render(events)
    MenuElement.render(self, events)
    if self.backSprite and self.blinkColor then
        if math.fmod(GlobalBlinkTimer * 2, 2) > 1 then
            self.backSprite:setColor(self.blinkColor[1], self.blinkColor[2], self.blinkColor[3])
        else
            self.backSprite:setColor(1, 1, 1)
        end
    end
end

---@class ScrollElement: BackgroundElement
---@field scroll number
---@field backScrollSprite RectSprite?
---@field fullScrollSprite RectSprite?
---@field pady number
---@field held boolean
ScrollElement = Inherit(BackgroundElement)
---@return Vec2
function ScrollElement:getSize()
    local chSize = self.child:getSize()
    return { math.max(self.size[1], chSize[1] + 15), self.size[2] }
end

---Create a scrollable element
---@param child MenuElement?
---@param background boolean|RectSpriteData?
---@param size Vec2?
---@param align string?
---@param pady number?
---@return ScrollElement
function ScrollElement:create(child, background, size, align, pady)
    if not child then child = MenuElement:create() end
    ---@cast background RectSpriteData?
    local bg = background
    if bg == nil or bg == true then
        bg = GetDefaultMenu()
    elseif bg == false then
        bg = nil
    end
    size = size or { 0, 0 }
    align = align or 'center'
    local chSize = child:getSize()
    local bgSize = size
    local scrollSize = math.min(size[2] / chSize[2], 1)
    ---@type ScrollElement
    local bg = {
        child = child,
        background = bg,
        backSprite = bg and bg:createSprite({ 0, 0 }, bgSize),
        backScrollSprite = bg and bg:createSprite({ 0, 0 }, { 15, size[2] }),
        fullScrollSprite = bg and GetDefaultScroll():createSprite({ 0, 0 }, { 11, math.floor(size[2] * scrollSize + 2) }),
        size = size,
        align = align,
        scroll = -5,
        pady = pady or 0,
        held = false
    }
    setmetatable(bg, self)
    self.__index = self

    bg:setVisible(false)

    bg.child.parent = { [1] = bg }

    return bg
end

function ScrollElement:scrollVisible()
    return self.child:getSize()[2] >= self.size[2]
end

---@return Vec2
function ScrollElement:getScrollPos()
    local chSize = self.child:getSize()
    local maxScroll = math.max(chSize[2] - self.size[2] + 5, 0)
    local scrollRatio = (self.scroll + 5) / (maxScroll + 5)
    local scrollSize = self.size[2] / chSize[2]
    scrollSize = math.floor(self.size[2] * math.min(scrollSize, 1))
    local r = VAdd(self.pos,
        { self.size[1] + 2 - 15, math.floor(scrollRatio * (self.size[2] - scrollSize - 6 - self.pady) + 2 + self.pady) })
    return r
end

---@param pos Vec2
function ScrollElement:setPosition(pos)
    self.pos = VCpy(pos)
    pos[2] = pos[2] - self.scroll
    local childSize = self.child:getSize()
    local size = self:getSize()
    if self:scrollVisible() then
        size[1] = size[1] - 15
    else
        if self.backScrollSprite then self.backScrollSprite:setVisible(false) end
        if self.fullScrollSprite then self.fullScrollSprite:setVisible(false) end
    end

    local mul = { 0.5, 0.0 }
    if self.align == 'left' then mul[1] = 0.0 end
    if self.align == 'right' then mul[1] = 1.0 end
    self.child:setPosition(VAdd(pos, VMul(VSub(size, childSize), mul)))
    if self.backSprite then self.backSprite:setPosition(self.pos) end
    if self.backScrollSprite then self.backScrollSprite:setPosition(VAdd(self.pos, { size[1], 0 })) end
    if self.fullScrollSprite then self.fullScrollSprite:setPosition(self:getScrollPos()) end
end

function ScrollElement:setVisible(visible)
    MenuElement.setVisible(self, visible)
    if not self:scrollVisible() then
        if self.backScrollSprite then self.backScrollSprite:setVisible(false) end
        if self.fullScrollSprite then self.fullScrollSprite:setVisible(false) end
    end
end

function ScrollElement:render(events)
    self.child:render(events)
    local chSize = self.child:getSize()
    local maxScroll = math.max(chSize[2] - self.size[2] + 5, -5)

    local selfRect = Rect(self:getPosition(), self:getSize())

    local sv = self:scrollVisible()
    if self.backScrollSprite and self.backScrollSprite.sprites[1].visible ~= sv then
        self.backScrollSprite:setVisible(sv)
        self.fullScrollSprite:setVisible(sv)
        self:setPosition(self.pos)
    end

    local s = self.scroll
    DoEvent("ScrollEvent", events, function(e)
        if not RContains(MPos, selfRect) then return end

        self.scroll = self.scroll + e.scroll * -32
    end)

    self.scroll = math.max(self.scroll, -5)
    self.scroll = math.min(self.scroll, maxScroll)
    if s ~= self.scroll then
        self:setPosition(self:getPosition())
        if self.fullScrollSprite then
            self.fullScrollSprite:setPosition(self:getScrollPos())
        end
    end


    self.child:setStencil(-1)
    if self.backSprite then
        self.backSprite.sprites[2].stencil = 1
        self.fullScrollSprite:setStencil(0)
    end

    local ss = self.size[2] * self.size[2] / chSize[2]
    local setScrollToMouse = function()
        local sy = (MPos[2] - self.pos[2] - ss / 2) / (self.size[2] - ss)
        sy = math.min(math.max(sy, 0), 1)
        self.scroll = sy * (maxScroll + 5) - 5
        self:setPosition(self:getPosition())
    end

    if math.floor(ss + 2) ~= self.fullScrollSprite.size[2] then
        self.scroll = -5
        self.fullScrollSprite = GetDefaultScroll():createSprite({ 0, 0 }, { 11, math.floor(ss + 2) })
        self.fullScrollSprite:setVisible(self:scrollVisible())
        self:setPosition(self.pos)
    end

    DoEvent("MouseButtonEvent", events, function(e)
        if e.action == 0 then
            self.held = false
        end
        if e.action ~= 1 then return end
        if not RContains(MPos, selfRect) then
            return
        end

        local scrollRect = Rect(VAdd(self:getPosition(), { self.size[1] - 15, 0 }), { 15, self.size[2] })

        if not RContains(MPos, scrollRect) then
            return
        end
        self.held = true
    end)
    if self.held then setScrollToMouse() end
end

function ScrollElement:setDepth(depth)
    MenuElement.setDepth(self, depth)
    if self.backScrollSprite then self.backScrollSprite:setDepth(depth + 0.15) end
    if self.fullScrollSprite then self.fullScrollSprite:setDepth(depth + 0.2) end
end

---@class ButtonElement: MenuElement
---@field textbox TextboxElement
---@field callback function
---@field size Vec2
---@field text string
ButtonElement = Inherit(TextboxElement)

---comment
---@param font Font
---@param text string
---@param callback function
---@param align string?
---@param size Vec2?
---@return ButtonElement
function ButtonElement:create(font, text, callback, align, size, width)
    size = size or { 0, 0 }
    width = width or 999
    ---@type ButtonElement
    local button = {
        textbox = TextboxElement:create(font, width, text, align),
        callback = callback,
        size = size,
        font = font,
        width = 999,
        align = align,
        text = text,
        visible = true
    }
    setmetatable(button, self)
    self.__index = self
    button:setVisible(self.visible)

    return button
end

---Set textbox text
---@param text string
function ButtonElement:setText(text)
    self.text = text
    self.textbox:setText(text)
    self.textbox:setPosition(self:getPosition())
    self.textbox:setDepth(self:getDepth() + 1)
    if self.visible == false then self.textbox:setVisible(false) end
end

---@param pos Vec2
function ButtonElement:setPosition(pos)
    self.pos = VCpy(pos)
    self.textbox:setPosition(pos)
end

function ButtonElement:render(events)
    DoEvent("MouseButtonEvent", events, function(e)
        if e.action ~= 1 or e.button ~= 0 then return end
        local sz = VCpy(self.textbox:getSize())

        local pos = VCpy(self.textbox:getPosition())

        if self.size[1] > sz[1] then
            pos[1] = pos[1] - 0.5 * (self.size[1] - sz[1])
            sz[1] = self.size[1]
        end
        if self.size[2] > sz[2] then
            pos[2] = pos[2] - 0.5 * (self.size[2] - sz[2])
            sz[2] = self.size[2]
        end

        if RContains(e.pos, { pos[1], pos[2], sz[1], sz[2] }) then
            self.callback()
        end
    end)
end

function ButtonElement:setVisible(visible)
    self.textbox:setVisible(visible)
    self.visible = visible
end

---@class SplitterElement: MenuElement
---@field children MenuElement[]
---@field vertical boolean true for vertical, false for horizontal
---@field spacing number
---@field align string?
---@field size Vec2
SplitterElement = Inherit(MenuElement)

---Create a splitter element
---@param children MenuElement[]
---@param vertical boolean
---@param spacing number?
---@param align string?
---@param size Vec2?
---@return SplitterElement
function SplitterElement:create(children, vertical, spacing, align, size)
    spacing = spacing or 0
    ---@type SplitterElement
    local bg = {
        children = children,
        vertical = vertical,
        spacing = spacing,
        align = align,
        size = size or { 0, 0 }
    }
    setmetatable(bg, self)
    self.__index = self
    return bg
end

---Set the position
---@param pos Vec2
function SplitterElement:setPosition(pos)
    pos = VCpy(pos)
    self.pos = pos
    local sz = self:getSize()

    local csz = self:getChildSize()

    local ax = 0.5
    if self.align == 'left' then ax = 0.0 end
    if self.align == 'right' then ax = 1.0 end


    pos = VAdd(pos, VMul(VSub(sz, csz), { ax, 0.0 }))

    for _, v in ipairs(self.children) do
        if self.vertical then
            local px = pos[1] + VMul(VSub(sz, v:getSize()), ax)[1]
            v:setPosition({ px, pos[2] })
            pos[2] = pos[2] + v:getSize()[2] + self.spacing
        else
            local py = pos[2] + VMul(VSub(sz, v:getSize()), 0.5)[2]
            v:setPosition({ pos[1], py })
            pos[1] = pos[1] + v:getSize()[1] + self.spacing
        end
    end
end

---Get the size of child elements
---@return Vec2
function SplitterElement:getChildSize()
    local size = { 0, 0 }
    if #self.children == 0 then return size end
    -- little hack since the spacing only applies to childcount-1
    if self.vertical then size[2] = -self.spacing else size[1] = -self.spacing end

    for _, v in ipairs(self.children) do
        local csize = v:getSize()
        if self.vertical then
            size = { math.max(size[1], csize[1]), size[2] + csize[2] + self.spacing }
        else
            size = { size[1] + csize[1] + self.spacing, math.max(size[2], csize[2]) }
        end
    end
    return size
end

---Get the size
---@return Vec2
function SplitterElement:getSize()
    return VMax(self:getChildSize(), self.size)
end

---Set the depth of child elements
---@param depth Vec2
function SplitterElement:setDepth(depth)
    self.depth = depth
    depth = depth + 0.1
    for _, v in ipairs(self.children) do
        v:setDepth(depth)
    end
end

---Set the depth of child elements
---@param visible boolean
function SplitterElement:setVisible(visible)
    for _, v in ipairs(self.children) do
        v:setVisible(visible)
    end
    self.visible = visible
end

---Destroy self and children
function SplitterElement:destroy(visible)
    for k, v in pairs(self.children) do
        v:destroy()
        self.children[k] = nil
    end
    self.children = nil
end

---Handle events
---@param events EventList
function SplitterElement:render(events)
    for _, v in pairs(self.children) do
        v:render(events)
    end
end

function SplitterElement:setStencil(stencil)
    for _, t in ipairs(self.children) do
        t:setStencil(stencil)
    end
end

---@class Menu
---@field pos Vec2
---@field visible boolean
---@field elements MenuElement[]
---@field background RectSpriteData
---@field backSprite RectSprite?
---@field showbg boolean
---@field stale boolean
Menu = {}
Menu.__index = Menu
Menu.isMenu = true

---Create a menu
---@param pos Vec2
---@param background RectSpriteData
---@param elements MenuElement[]?
---@param showbg boolean?
---@return Menu
function Menu:create(pos, background, elements, showbg)
    local sbg = true
    if showbg == nil then sbg = true else sbg = showbg end
    ---@type Menu
    local menu = {
        pos = VCpy(pos),
        visible = true,
        background = background,
        elements = elements or {},
        stale = true,
        depth = UIDepth,
        showbg = sbg
    }
    setmetatable(menu, self)
    self.__index = self
    menu:setPosition(pos)
    menu:setDepth(0)
    menu:setVisible(true)
    return menu
end

---Set position of the menu and its elements
---@param pos Vec2
function Menu:setPosition(pos)
    self.pos = VCpy(pos)
    for _, v in pairs(self.elements) do
        v:setPosition(VAdd(pos, { 2, 2 }))
    end
    if self.backSprite then self.backSprite:setPosition(pos) end
end

---Set depth of the menu and its elements
---@param depth number
function Menu:setDepth(depth)
    depth = depth
    self.depth = depth
    for _, v in pairs(self.elements) do
        v:setDepth(depth + 0.1)
    end
    if self.backSprite then self.backSprite:setDepth(depth) end
end

---Set whether the menu is visible or not
---@param visible any
function Menu:setVisible(visible)
    for _, v in pairs(self.elements) do
        v:setVisible(visible)
    end
    self.visible = visible
    if self.backSprite then self.backSprite:setVisible(visible) end
end

---Get the size of the menu
---@return Vec2
function Menu:getSize()
    local sizex = 0
    local sizey = 0
    for _, v in pairs(self.elements) do
        local sz = v:getSize()
        sizex = sz[1] + 6
        sizey = sz[2] + 4
    end
    return { sizex, sizey }
end

---Destroy the menu and its elements
function Menu:destroy()
    for _, v in pairs(self.elements) do
        v:destroy()
    end
end

---Render the menu
---@param events EventList
function Menu:render(events)
    local sizex = 0
    local sizey = 0
    for _, v in pairs(self.elements) do
        local sz = v:getSize()
        sizex = sz[1] + 6
        sizey = sz[2] + 4
        v:render(events)
    end

    if self.stale and self.visible and self.showbg then
        self.backSprite = self.background:createSprite({ 0, 0 }, { sizex, sizey })
        self:setPosition(self.pos)
        self:setDepth(self.depth)
        self.stale = false
    end
end

---@class SimpleButton
SimpleButton = {}

---Create a simple button
---@param pos Vec2
---@param text string
---@param callback function
---@param align string?
---@return Menu
function SimpleButton:create(pos, text, callback, align)
    return Menu:create(pos, GetDefaultMenu(), { ButtonElement:create(GetDefaultFont(), text, callback, align) })
end

---@class ImageElement: MenuElement
---@field sprite Sprite
---@field pos Vec2
ImageElement = MenuElement:create()
ImageElement.__index = ImageElement

---Image element
---@param path string
---@param rect Rect
---@param size Vec2?
---@param frames integer?
---@param speed number?
---@return ImageElement
function ImageElement:create(path, rect, size, frames, speed)
    local ret = {}
    setmetatable(ret, self)
    self.__index = self

    size = size or { rect[3], rect[4] }
    ret.sprite = SpriteData:create(path, size, rect, 0, frames, speed):createSprite({ 0, 0 }, size)
    ret.sprite.visible = false
    ret.size = size

    return ret
end

---Set position
---@param pos Vec2
function ImageElement:setPosition(pos)
    self.pos = pos
    self.sprite.x = pos[1] + 1
    self.sprite.y = pos[2] + 1
end

---Get position
---@return Vec2
function ImageElement:getPosition()
    return self.pos
end

---Get size
---@return Vec2
function ImageElement:getSize()
    return VAdd({ self.sprite.w, self.sprite.h }, { 2, 2 })
end

---Set stencil
---@param stencil integer
function ImageElement:setStencil(stencil)
    self.sprite.stencil = stencil
end

---Set visible
---@param visible boolean
function ImageElement:setVisible(visible)
    self.sprite.visible = visible
end

---@param depth number
function ImageElement:setDepth(depth)
    self.depth = depth
    self.sprite.depth = depth + 0.1
end
---@class CreateSpriteArgs
---@field pos Vec2
---@field path string
---@field size Vec2
---@field rect integer[]
---@field depth number

---@class Sprite
---@field x number
---@field y number
---@field w number
---@field h number
---@field r number
---@field g number
---@field b number
---@field a number
---@field flip boolean
---@field depth number
---@field visible boolean
---@field stencil number
---@field camera boolean

---@type fun(args: CreateSpriteArgs): Sprite
CreateSprite = CreateSprite
---@type fun(args: CreateSpriteArgs): Sprite
DrawSprite = DrawSprite
---@type fun(args: Sprite[]): Sprite
StitchSprite = StitchSprite

---@type fun(): Vec2
GetCamera = GetCamera
---@type fun(pos: Vec2): nil
SetCamera = SetCamera

---@class SpriteData
---@field path string
---@field size Vec2
---@field rect integer[]
---@field depth number
---@field frames integer | nil
---@field speed number | nil
SpriteData = {}
SpriteData.__index = SpriteData

---Create Sprite Data
---@param path string
---@param size Vec2
---@param rect integer[]?
---@param depth number
---@param frames integer | nil
---@param speed number | nil
---@return SpriteData
function SpriteData:create(path, size, rect, depth, frames, speed)
    ---@type SpriteData
    rect = rect or { 0, 0, 0, 0 }
    local spriteData = {
        path = MakePath(path),
        size = size,
        rect = rect,
        depth = depth,
        frames = frames,
        speed = speed
    }
    setmetatable(spriteData, self)
    return spriteData
end

---Create Sprite
---@param pos Vec2
---@param size Vec2?
---@return Sprite
function SpriteData:createSprite(pos, size)
    return CreateSprite({
        pos = VCpy(pos),
        path = self.path,
        size = VCpy(size) or self.size,
        rect = self.rect,
        depth = self.depth,
        frames = self.frames,
        speed = self.speed
    })
end

---Draw Sprite on this frame
---@param pos Vec2
---@return Sprite
function SpriteData:drawSprite(pos)
    return DrawSprite({
        pos = pos,
        path = self.path,
        size = self.size,
        rect = self.rect,
        depth = self.depth
    })
end
