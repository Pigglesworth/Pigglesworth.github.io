GetLevelsCleared = GetLevelsCleared

if not SaveData then SaveData = {} end

---@alias Vec2 integer[]
---@alias Rect integer[]

---Returns a table with weak value ownership
---@param mode string
---@return table
function WeakTable(mode)
    mode = mode or "v"
    return setmetatable({}, { __mode = mode })
end

---Copy a Vec2 or Rect into a new table
---@generic T: integer[] | integer[]?
---@param v T
---@return T
function VCpy(v)
    if v == nil then return nil end
    return { v[1], v[2], v[3], v[4] }
end

---Check equality of vectors
---@param v1 Vec2
---@param v2 Vec2
---@return boolean
function VEq(v1, v2)
    return v1[1] == v2[1] and v1[2] == v2[2]
end

---Add vector by another vector or number
---@param v1 Vec2
---@param v2 Vec2 | number
---@return Vec2
function VAdd(v1, v2)
    if type(v2) == "number" then v2 = { v2, v2 } end
    return { v1[1] + v2[1], v1[2] + v2[2] }
end

---Subtract vector by another vector or number
---@param v1 Vec2
---@param v2 Vec2 | number
---@return Vec2
function VSub(v1, v2)
    if type(v2) == "number" then v2 = { v2, v2 } end
    return { v1[1] - v2[1], v1[2] - v2[2] }
end

---Multiply vector by another vector or number
---@param v1 Vec2
---@param v2 Vec2 | number
---@return Vec2
function VMul(v1, v2)
    if type(v2) == "number" then v2 = { v2, v2 } end
    return { v1[1] * v2[1], v1[2] * v2[2] }
end

---Get the max of for each vector dimension
---@param v1 Vec2
---@param v2 Vec2 | number
---@return Vec2
function VMax(v1, v2)
    if type(v2) == "number" then v2 = { v2, v2 } end
    return { math.max(v1[1], v2[1]), math.max(v1[2], v2[2]) }
end

---Lerp between vectors
---@param v1 Vec2
---@param v2 Vec2
---@param t number
---@return Vec2
function VLerp(v1, v2, t)
    return { v1[1] + t * (v2[1] - v1[1]), v1[2] + t * (v2[2] - v1[2]) }
end

---Lerp between vectors independently
---@param v1 Vec2
---@param v2 Vec2
---@param t Vec2
---@return Vec2
function VLerp2(v1, v2, t)
    return { v1[1] + t[1] * (v2[1] - v1[1]), v1[2] + t[2] * (v2[2] - v1[2]) }
end

---Get the distance between two vectors
---@param v1 Vec2
---@param v2 Vec2
---@return number
function VDist(v1, v2)
    local dx = v2[1] - v1[1]
    local dy = v2[2] - v1[2]
    return math.sqrt(dx * dx + dy * dy)
end

---Construct a rectangle from size and position
---@param pos Vec2
---@param size Vec2
function Rect(pos, size)
    return { pos[1], pos[2], size[1], size[2] }
end

---Add vector or number to rect
---@param r1 Rect
---@param r2 Rect | number
---@return Vec2
function RAdd(r1, r2)
    if type(r2) == "number" then r2 = { r2, r2 } end
    return { r1[1] + r2[1], r1[2] + r2[2], r1[3], r1[4] }
end

---Returns true if rect contains v
---@param v Vec2
---@param rect integer[]
function RContains(v, rect)
    return
        v[1] >= rect[1] and
        v[1] <= rect[1] + rect[3] and
        v[2] >= rect[2] and
        v[2] <= rect[2] + rect[4]
end

---Returns overlap of two rectangles
---@param rect1 integer[]
---@param rect2 integer[]
---@return integer[]
function ROverlap(rect1, rect2)
    local minx = math.max(rect1[1], rect2[1])
    local maxx = math.min(rect1[1] + rect1[3], rect2[1] + rect2[3])

    local miny = math.max(rect1[2], rect2[2])
    local maxy = math.min(rect1[2] + rect1[4], rect2[2] + rect2[4])

    return { minx, miny, math.max(maxx - minx, 0), math.max(maxy - miny, 0) }
end

---Returns the area of intersect of two rectangles
---@param rect1 integer[]
---@param rect2 integer[]
---@return number
function RIntersect(rect1, rect2)
    local o = ROverlap(rect1, rect2)
    return o[3] * o[4]
end

---Select a random element from an array
---@param tb any[]
---@return any
function table.select(tb)
    return tb[math.random(#tb)]
end

---Select a random element from an array
---@param tb any[]
---@return any
---@return any
function table.selectKeyValue(tb)
    local list = {}
    for k, v in pairs(tb) do
        list[#list + 1] = { k, v }
    end
    local s = list[math.random(#list)]
    return s[1], s[2]
end

---Copy a table
---@param table any
---@return table
function table.copy(table)
    local cpy = {}
    for k, v in pairs(table) do
        cpy[k] = v
    end
    return cpy
end

---Append a table
---@generic T
---@param table T[]
---@param value T
---@return table
function table.append(table, value)
    table[#table + 1] = value
    return table
end

---Grab a value from an array
---@generic T
---@param tb T[]
---@param index number?
---@return T
function table.grab(tb, index)
    local pos = index or math.random(#tb)
    return table.remove(tb, pos)
end

---Return a random value from an array
---@generic T
---@param tb T[]
---@return T
function table.random(tb)
    local pos = math.random(#tb)
    return tb[pos]
end

---Get number of entries in a table
---@generic T
---@param table T[]
---@return integer
function table.count(table)
    local ret = 0
    for k, _ in pairs(table) do
        ret = ret + 1
    end
    return ret
end

---Get whether object is in a table
---@generic T
---@param table T[]
---@param entry T
---@return boolean
function table.contains(table, entry)
    for _, v in pairs(table) do
        if v == entry then return true end
    end
    return false
end

---Insert into first open numeric slot
---@generic T
---@param table T[]
---@param value T
---@return table
---@return integer
function table.insertFirst(table, value)
    local i = 1
    while true do
        if table[i] == nil then
            table[i] = value
            return table, i
        end
        i = i + 1
    end
end

---Insert into the position and push back the reamining elements
---@generic T
---@param table T[]
---@param i integer
---@param value T
---@return table
function table.insertAt(table, i, value)
    local nextslot = 1
    for j = 1, i - 1 do
        if table[j] == nil then
            nextslot = -1
            break
        end
    end

    repeat
        local next = table[i]
        table[i] = value
        value = next
        i = i + nextslot
    until value == nil
    return table
end

---Get last number of table
---@generic T
---@param table T[]
---@return integer
function table.lastIndex(table)
    local ret = 0
    for k, _ in pairs(table) do
        ret = math.max(ret, k)
    end
    return ret
end

function table.eraseFirst(tb, val)
    for i, v in ipairs(tb) do
        if v == val then
            return table.remove(tb, i)
        end
    end
    return nil
end

function spairs(tb)
    local i = 0
    local last = table.lastIndex(tb)
    return function()
        while i <= last do
            i = i + 1
            if tb[i] then return i, tb[i] end
        end
    end
end

---Iterate over a list and return the object that has the highest value greater than man
---@generic T
---@param tb T[]
---@param fn fun(object: T): number
---@param min number?
---@return T?
---@return number
function BestOf(tb, fn, min)
    local best = min or 0
    local bestObj = nil
    for _, v in pairs(tb) do
        local score = fn(v)
        if score > best then
            best = score
            bestObj = v
        end
    end
    return bestObj, best
end

---Inherit from table
---@generic T
---@generic U: `T`
---@param object `T`
---@return U
function Inherit(object)
    object.__index = object
    local ret = {}
    setmetatable(ret, object)
    ret.__index = ret
    return ret
end

---Bind an argument to a function
---@param func function
---@return function
function Bind(func, arg)
    return function() func(arg) end
end

---@type fun(seed: integer): integer
CPPRandom = CPPRandom

---@type fun(): integer
CPPRandomSeed = CPPRandomSeed

local function randomVal(seed)
    return CPPRandom(seed)
end

---@class RandomGenerator
---@field name string
---@field seed integer
RandomGenerator = {}
RandomGenerator.__index = RandomGenerator

---Create a new generator
---@param name string
---@param seed integer?
---@return RandomGenerator
function RandomGenerator:create(name, seed)
    seed = seed or 1
    ---@type RandomGenerator
    local ret = {
        name = name,
        seed = seed
    }
    setmetatable(ret, self)
    self.__index = self
    ret:setSeed(seed)
    return ret
end

---Set the seed of the random generator
---@param seed number
function RandomGenerator:setSeed(seed)
    for i = 1, #self.name do
        seed = randomVal(seed + self.name:byte(i, i))
    end
    self.seed = seed
end

---comment
---@param i any
---@param j any
function RandomGenerator:getRandom(i, j)
    self.seed = randomVal(self.seed)
    return (self.seed % (1 + j - i)) + i
end

---@class RandomBag
---@field name string
---@field tb table
---@field indices integer[]
---@field generator RandomGenerator
RandomBag = {}
RandomBag.__index = RandomBag

function RandomBag:makeBag()
    for k, _ in ipairs(self.tb) do
        self.indices[#self.indices + 1] = k
    end
end

---Set the seed of the random bag
---@param seed number
function RandomBag:setSeed(seed)
    self.generator:setSeed(seed)
    self:makeBag()
end

function RandomBag:grab()
    if #self.indices < 1 then
        self:makeBag()
    end
    local i = self.generator:getRandom(1, #self.indices)
    local k = table.remove(self.indices, i)
    return self.tb[k]
end

---Create a random bag to draw from
---@param name string
---@param table table
---@param seed integer
---@param generator RandomGenerator
---@return RandomBag
function RandomBag:create(name, table, seed, generator)
    ---@type RandomBag
    local ret = {
        name = name,
        seed = seed,
        generator = generator,
        tb = table,
        indices = {}
    }
    setmetatable(ret, self)
    self.__index = self
    ret:setSeed(seed)
    return ret
end

---@class Randomizer
---@field gens RandomGenerator[]
---@field bags RandomBag[]
---@field seed integer
Randomizer = {
    gens = {},
    bags = {},
    seed = 1
}
Randomizer.__index = Randomizer

---Create a random bag
---@param name string
---@return RandomGenerator
function Randomizer:createGenerator(name)
    if not self.gens[name] then
        self.gens[name] = RandomGenerator:create(name, self.seed)
    end
    return self.gens[name]
end

---Create a random bag
---@param name string
---@param table table
---@return RandomBag
function Randomizer:createBag(name, table)
    self.bags[name] = RandomBag:create(name, table, self.seed, self:createGenerator(name))
    return self.bags[name]
end

---Set all random seeds
---@param seed number
function Randomizer:setSeed(seed)
    self.seed = seed
    for _, v in pairs(self.gens) do
        v:setSeed(seed)
    end
    for _, v in pairs(self.bags) do
        v:setSeed(seed)
    end
end

---Make a numeric value pretty
---@param val number
---@return string
function Scorify(val, mul)
    if not mul then mul = 10 end
    if val < 1000 * mul then return '' .. val end

    local suffix = nil
    local sval = 1
    local suffixTable = { 'K', 'M', 'B', 'T', 'QA', 'QI', 'SX', 'SP', 'O', 'N', 'D' }
    for i, v in ipairs(suffixTable) do
        local sv = 10 ^ (i * 3)
        if val >= sv * mul and val < sv * 1000 * mul then
            suffix = v
            sval = sv
        end
    end
    if suffix then
        if mul == 1 then return string.format("%3.1f", val / sval) .. suffix end
        return string.format("%4.1f", val / sval) .. suffix
    end
    return string.format("%8.2g", val)
end
require 'terminalmenu.lua'

---@class MessageElement: TerminalElement
MessageElement = Inherit(TerminalElement)
MessageElement.patternList = {}

MessageElement.intro = ([[
Look like some of your old chat logs are here. 
Might be worth checking out, if only to see how many
]]
):gsub('\n([^\n])', ' %1')

---@class BackgroundElementEx: BackgroundElement
---@field ax number
---@class TextboxElementEx: TextboxElement
---@field ax number

---Message element
---@param font Font
---@param width number
---@param text string?
---@param align string?
---@param size integer
---@return MessageElement
function MessageElement:create(font, width, text, align, size)
    local ret = {}
    setmetatable(ret, self)
    self.__index = self

    text = text or ""
    size = size or 1
    ret.font = font
    ret.width = width
    ret.align = align
    ret.textsize = size
    ret.pos = { 0, 0 }

    ret.textboxes = {}
    return ret
end

MessageElement:addPattern('%b[]', function(self, line)
    local name = line:sub(2, #line - 1)
    self.ax = 1 - self.ax
    for axstr in name:gmatch('ax=(%S*)') do
        self.ax = tonumber(axstr) or self.ax
    end
    name = name:gsub('ax=%S*', '')


    local col = self.ax == 1 and '{cyan}' or '{yellow}'
    if self.ax < 0.6 and self.ax > 0.4 then col = '{red}' end
    if name == '' then
        ---@cast self any
        if self.nameList and self.nameList[self.ax] then
            name = self.nameList[self.ax]
        else
            return MenuElement:create()
        end
    else
        ---@cast self any
        self.nameList = self.nameList or {}
        self.nameList[self.ax] = name
    end

    return TextboxElement:create(self.font, self.width * 0.75, col .. name, 'center',
        self.textsize)
end)

---@return { name: string, content: string }[]
function MessageElement:getContentList()
    local ret = {}
    local i = 0
    while i < GetMessageMenuCount() do
        i = i + 1
        local p = 'text/duo/duo' .. tostring(i) .. '.txt'
        local c = LoadText(p)
        if #c == 0 then
            break
        end
        local title = c:match('[^\n]*')
        c = c:gsub('[^\n]*[\n][\r]?', '', 1)
        ret[i] = {
            name = title,
            content = c
        }
    end
    return ret
end

---Set textbox text
---@param text string
function MessageElement:setText(text)
    for _, t in ipairs(self.textboxes) do
        t:destroy()
    end
    self.textboxes = {}

    self.ax = 1
    local pattern = '[^\n\r]+'

    ---@type TextboxElementEx[]
    local addList = {}
    local function doAdd(ax)
        local szX = 0
        for _, v in ipairs(addList) do
            szX = math.max(szX, v:getSize()[1])
        end
        for _, v in ipairs(addList) do
            local ele = BackgroundElement:create(v, true, { szX, 0 }, 'left')
            ---@cast ele BackgroundElementEx
            ele.ax = ax
            table.append(self.textboxes, ele)
        end
        addList = {}
    end

    for line in text:gmatch(pattern) do
        local count = 0
        line, count = line:gsub('[\n\r]*', '')
        local lax = self.ax

        local ele
        for _, pattern in pairs(self:getPatterns()) do
            if line:match(pattern.match) then
                ele = pattern.func(self, line)
                if ele then
                    ---@cast ele TextboxElementEx
                    ele.ax = self.ax
                    if self.ax ~= lax then doAdd(lax) end
                    table.append(self.textboxes, ele)
                    goto continue
                end
            end
        end

        if self.ax ~= lax then doAdd(lax) end
        table.append(addList,
            TextboxElement:create(self.font, self.width * 0.6, line, 'left', self.textsize))
        ::continue::
    end
    doAdd(self.ax)

    self:setPosition(self.pos)
    self:setVisible(self.visible)
end

GetMessageMenuCount = function()
    return GetLevelsCleared() - (GetNewsMenuCount() + GetMythMenuCount())
end
require 'terminalmenu.lua'

---@class MythMenu: TerminalElement
---@field textboxes TextboxElementEx[]
---@field notes {[string]: string}
---@field parent {[1]: any}
MythMenu = Inherit(TerminalElement)
MythMenu.patternList = TerminalElement.patternList

MythMenu.tooltip = nil
MythMenu.intro = ([[
I compiled a list of some of my favourite stories that I thought were worth sharing.

I added some of my own commentary to each entry. I hope you don't find my thoughts too out there!]]
):gsub('\n([^\n])', ' %1')


function MythMenu:create(font, width, text, align, size)
    local ret = TerminalElement.create(self, font, width, text, align, size)
    setmetatable(ret, self)
    self.__index = self
    self.notes = {}
    return ret
end

---@return { name: string, content: string }[]
function MythMenu:getContentList()
    local ret = {}
    local i = 0
    while i < GetMythMenuCount() do
        i = i + 1
        local p = 'text/myth/myth' .. tostring(i) .. '.txt'
        local c = LoadText(p)
        if #c == 0 then
            break
        end
        local title = c:match('[^\n]*')
        c = c:gsub('[^\n]*[\n][\r]?', '', 1)
        ret[i] = {
            name = title,
            content = c
        }
    end
    return ret
end

MythMenu:addPattern('%[note=%d+%]%s*[^\n]*', function(self, line)
    local note = line:match('%[note=%d*%]'):gsub('[^%d]*', '')
    local text = line:gsub('%[note=%d+%]%s*\n?', '')
    ---@cast self MythMenu
    self.notes['!' .. note] = text
    return true
end)

function MythMenu:render(events)
    local tt, rr
    local parent = self.parent[1]
    if not RContains(MPos, Rect(parent.pos, parent:getSize())) then
        MythMenu.tooltip = nil
        return
    end
    for _, t in ipairs(self.textboxes) do
        if not t.doCallbacks then goto continue end
        t:doCallbacks(events, function(name, rect)
            if name:sub(1, 1) ~= '!' then return end
            tt = name
            rr = rect
        end)
        ::continue::
    end
    local ttip = MythMenu.tooltip
    ---@cast ttip any
    if not tt then
        MythMenu.tooltip = nil
    elseif not MythMenu.tooltip or ttip.name ~= tt then
        local name = tt
        local rect = rr
        local txt = self.notes[name] or 'No comment'
        local tbe = TextboxElement:create(GetDefaultFont(), 200, txt)
        local ime = ImageElement:create('../shared/icon.png', { 0, 0, 34, 34 }, nil, 4, 0.03)
        MythMenu.tooltip = BackgroundElement:create(SplitterElement:create({ ime, tbe }, false))
        local sz = MythMenu.tooltip:getSize()
        MythMenu.tooltip:setVisible(true)

        local ttpos = VAdd(rect, { rect[3] / 2 - sz[1] / 2, -sz[2] })
        ttpos[1] = math.min(ttpos[1], 512 - sz[1])
        ttpos[1] = math.max(ttpos[1], 0)
        if ttpos[2] < 0 then
            ttpos[2] = rect[2] + rect[4]
        end
        ttpos[2] = math.min(ttpos[2], 384 - sz[2])

        MythMenu.tooltip:setPosition(ttpos)
        MythMenu.tooltip:setDepth(self.depth + 150)
        ttip = MythMenu.tooltip
        ---@cast ttip any
        ttip.name = name
    end
    if MythMenu.tooltip then MythMenu.tooltip:render(events) end
end

GetMythMenuCount = function()
    return math.floor((GetLevelsCleared() + 2) / 5)
end
if GetMythMenuCount() == 0 then
    MythMenu.intro = "Looks like there's nothing here yet. You'll have to finish decrypting more sections."
end
require 'terminalmenu.lua'

---@class NewsElement: TerminalElement
---@field textboxes TextboxElementEx[]
---@field speaker integer
NewsElement = Inherit(TerminalElement)
NewsElement.patternList = {}
for i, p in ipairs(TerminalElement.patternList) do
    NewsElement.patternList[#NewsElement.patternList + 1] = p
end

function NewsElement:create(font, width, text, align, size)
    ---@class NewsElement
    local ret = TerminalElement.create(self, font, width, text, align, size)
    setmetatable(ret, self)
    self.__index = self
    return ret
end

NewsElement:addPattern('%b[].-\n[^\n%[]*', function(self, line)
    if not self.speaker then self.speaker = 0 end
    self.speaker = 1 - self.speaker
    if line:match('%b[]') == '[A]' then self.speaker = 1 end
    if line:match('%b[]') == '[I]' then self.speaker = 0 end
    local align = self.speaker == 1 and 'left' or 'right'
    local speakerText = self.speaker == 1
        and '{red}Alexei:\n{white}'
        or '{magenta}Interviewer:\n{white}'
    local text = line:gsub('%b[]%s*\n', speakerText)
    self.ax = 0
    return TextboxElement:create(self.font, self.width * 0.95, text, 'left', 1)
end)

---@return { name: string, content: string }[]
function NewsElement:getContentList()
    local ret = {}
    local i = 0
    while i < GetNewsMenuCount() do
        i = i + 1
        local p = 'text/news/news' .. tostring(i) .. '.txt'
        local c = LoadText(p)
        if #c == 0 then
            break
        end
        local title = c:match('[^\n]*')
        title = title:gsub('\\\\', '\n')
        c = c:gsub('[^\n]*[\n][\r]?', '', 1)
        ret[i] = {
            name = title,
            content = c
        }
    end
    return ret
end

function NewsElement:render(events)
    for _, t in ipairs(self.textboxes) do
        --t:doCallbacks(events, function(name) print(name) end)
    end
end

GetNewsMenuCount = function()
    return math.floor((GetLevelsCleared() + 3) / 5)
end
if GetNewsMenuCount() == 0 then
    NewsElement.intro = "Nothing here. Well, who wants to bother reading old interviews?"
end
