---@class KeyEvent
---@field type string
---@field key integer

---@class TextEvent
---@field code string

---@class MousePositionEvent
---@field type string
---@field pos Vec2
---@field delta Vec2

---@class MouseButtonEvent
---@field type string
---@field pos Vec2
---@field button integer
---@field action integer

---@class ScrollEvent
---@field type string
---@field scroll number
---@field scrollX number

---@alias EventList (KeyEvent | TextEvent | MousePositionEvent | MouseButtonEvent | ScrollEvent)[]

---@type EventList
Events = Events

MPos = { 0, 0 }

---Do a function on each event in the list
---@param type string
---@param events EventList
---@param func function
function DoEvent(type, events, func)
    for _, v in pairs(events) do
        if v.type == type then
            func(v)
        end
    end
end
